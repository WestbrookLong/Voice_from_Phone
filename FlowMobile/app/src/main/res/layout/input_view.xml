<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/flow_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textColor="@color/flow_accent"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/previewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/panel_bg"
        android:minHeight="64dp"
        android:padding="12dp"
        android:text="@string/preview_placeholder"
        android:textColor="@color/flow_text"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg"
            android:contentDescription="@string/start_listening"
            android:padding="12dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/flow_text" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg"
            android:contentDescription="@string/command_send"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            app:tint="@color/flow_text" />

        <ImageButton
            android:id="@+id/backspaceButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg"
            android:contentDescription="@string/command_backspace"
            android:padding="12dp"
            android:src="@drawable/ic_backspace"
            app:tint="@color/flow_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button android:id="@+id/keyQ" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyW" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyE" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyR" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyT" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyY" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyU" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyI" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyO" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyP" style="@style/Widget.FlowMobile.Key" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.4" />

        <Button android:id="@+id/keyA" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyS" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyD" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyF" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyG" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyH" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyJ" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyK" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyL" style="@style/Widget.FlowMobile.Key" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.4" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keyShift"
            style="@style/Widget.FlowMobile.WideKey"
            android:text="@string/shift_off" />

        <Button android:id="@+id/keyZ" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyX" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyC" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyV" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyB" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyN" style="@style/Widget.FlowMobile.Key" />
        <Button android:id="@+id/keyM" style="@style/Widget.FlowMobile.Key" />

        <Button
            android:id="@+id/keyBackspace"
            style="@style/Widget.FlowMobile.WideKey"
            android:text="@string/key_backspace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keyMode"
            style="@style/Widget.FlowMobile.WideKey"
            android:text="@string/mode_symbols" />

        <Button
            android:id="@+id/keyComma"
            style="@style/Widget.FlowMobile.Key"
            android:text="@string/key_comma" />

        <Button
            android:id="@+id/keySpace"
            style="@style/Widget.FlowMobile.SpaceKey"
            android:text="@string/key_space" />

        <Button
            android:id="@+id/keyPeriod"
            style="@style/Widget.FlowMobile.Key"
            android:text="@string/key_period" />

        <Button
            android:id="@+id/keySlash"
            style="@style/Widget.FlowMobile.Key"
            android:text="@string/key_slash" />

        <Button
            android:id="@+id/keyEnter"
            style="@style/Widget.FlowMobile.WideKey"
            android:text="@string/key_enter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keyDeleteWord"
            style="@style/Widget.FlowMobile.LongKey"
            android:text="@string/command_delete_word" />
    </LinearLayout>
</LinearLayout>
